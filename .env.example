# 토스증권 WTS > 설정 > Open API 에서 발급 (절대 커밋/공유 금지)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# GET /api/v1/accounts 로 확인한 accountSeq (비우면 첫 번째 계좌 자동 사용)
TOSS_ACCOUNT_SEQ=

# (선택) IP 가 자주 바뀌면: 고정 IP 서버를 거쳐 접속. 둘 중 하나만 쓰세요. 허용 IP 에는 그 서버의 IP 만 등록.
# SSH 터널(권장, SSH 키로 비밀번호 없이 접속 가능해야 함):
TOSS_SSH_TUNNEL=
# 또는 프록시 주소 직접 지정 (예: http://user:pass@1.2.3.4:3128, socks5h://127.0.0.1:1080):
TOSS_PROXY=
